<resources>

    <!-- METR Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- METR Brand Colors -->
        <item name="colorPrimary">@color/metr_primary_electric</item>
        <item name="colorPrimaryDark">@color/metr_dark_background</item>
        <item name="colorAccent">@color/metr_accent_pink</item>
        
        <!-- Window and UI -->
        <item name="android:windowBackground">@color/splashscreen_bg</item>
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:statusBarColor">@color/metr_dark_background</item>
        <item name="android:navigationBarColor">@color/metr_dark_background</item>
        
        <!-- Typography -->
        <item name="android:textColorPrimary">@color/metr_dark_text</item>
        <item name="android:textColorSecondary">#A3A3A3</item>
    </style>

</resources>
