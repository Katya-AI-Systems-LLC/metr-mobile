# Auto detect text files and perform LF normalization
* text=auto

# Source files
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Shell scripts
*.sh text eol=lf

# Gradle files
*.gradle text eol=lf

# XML files
*.xml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.apk binary
*.ipa binary
*.aab binary
*.jar binary
*.so binary
*.dylib binary
*.dll binary

# Archives
*.zip binary
*.tar binary
*.gz binary

# Database
*.db binary
*.sqlite binary
*.sqlite3 binary

# Certificates
*.p12 binary
*.cer binary
*.crt binary
*.key binary
*.pem binary

# iOS
*.pbxproj text eol=lf
*.xcscheme text eol=lf
*.plist text eol=lf

# Android
*.properties text eol=lf
