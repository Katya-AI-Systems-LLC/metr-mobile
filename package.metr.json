  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "clean": "watchman watch-del-all && rm -rf node_modules && npm install",
    "pod-install": "cd ios && pod install",
    "postinstall": "patch-package",
    
    "// METR Specific Scripts": "",
    "ai:train": "node scripts/ai/train-models.js",
    "ai:test": "jest --testPathPattern=ai",
    "web3:deploy": "hardhat run scripts/deploy.js",
    "web3:test": "hardhat test",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:ios": "cd ios && xcodebuild -workspace Metr.xcworkspace -scheme Metr -configuration Release",
    "deploy:beta": "npm run build:android && npm run build:ios && node scripts/deploy-beta.js",
    "analyze:bundle": "npx react-native-bundle-visualizer"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "metr": {
    "version": "3.0.0",
    "features": {
      "ai": true,
      "web3": true,
      "ar": true,
      "offline": true,
      "e2ee": true
    },
    "branding": {
      "name": "METR",
      "tagline": "Measure Your Team's Potential",
      "primaryColor": "#8B5CF6",
      "secondaryColor": "#14B8A6",
      "accentColor": "#EC4899"
    }
  }
